---
import { siteConfig } from '../config/site';

const siteUrl = siteConfig.url;
const orgName = siteConfig.name;
const canonicalUrl = `${siteUrl}/about/`;

const aboutJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": orgName,
      "url": `${siteUrl}/`,
      "description": siteConfig.description,
      "publishingPrinciples": `${siteUrl}/about/#editorial-protocol`,
      "sameAs": siteConfig.author.sameAs
    },
    {
      "@type": "AboutPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": `About ${orgName} | Entity Home & Editorial Governance`,
      "mainEntity": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en-US"
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Entity Home &amp; Editorial Governance | {orgName}</title>
  <meta name="description" content={`Institutional credentials, primary-source editorial standards, and Knowledge Graph registry for ${orgName}.`} />
  <link rel="canonical" href={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} />

  <style>
    :root {
      --bg-white: #ffffff;
      --surface-subtle: #f8fafc;
      --border-light: #e2e8f0;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-primary: #1d4ed8;
      --accent-hover: #1e40af;
      --max-width-prose: 780px;
      --max-width-layout: 1120px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-white); color: var(--text-primary); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.7; font-size: 1.0625rem; }
    a { color: var(--accent-primary); text-decoration: underline; text-underline-offset: 3px; }
    .site-header { border-bottom: 1px solid var(--border-light); padding: 1.25rem 1.5rem; }
    .header-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
    .brand-title { font-weight: 800; font-size: 1.25rem; color: var(--text-primary); text-decoration: none; }
    .primary-nav ul { display: flex; flex-wrap: wrap; list-style: none; gap: 1.5rem; }
    .primary-nav a { text-decoration: none; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; }
    .primary-nav a[aria-current="page"] { color: var(--accent-primary); font-weight: 700; }
    main { max-width: var(--max-width-prose); margin: 2.5rem auto 4rem; padding: 0 1.5rem; }
    .eyebrow { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 0.75rem; }
    h1 { font-size: clamp(2rem, 4vw, 2.5rem); line-height: 1.2; font-weight: 800; margin-bottom: 1.25rem; }
    h2 { font-size: 1.5rem; font-weight: 700; margin: 2.5rem 0 0.85rem; }
    p { margin-bottom: 1.25rem; color: var(--text-secondary); }
    .entity-box { background-color: var(--surface-subtle); border: 1px solid var(--border-light); border-left: 4px solid var(--accent-primary); border-radius: 6px; padding: 1.5rem; margin: 1.75rem 0; }
    dl.entity-specs { display: grid; grid-template-columns: 200px 1fr; gap: 0.75rem; font-size: 0.95rem; }
    dt { font-weight: 700; color: var(--text-primary); }
    dd { color: var(--text-secondary); }
    .site-footer { border-top: 1px solid var(--border-light); padding: 2.5rem 1.5rem; font-size: 0.9rem; color: var(--text-muted); }
    .footer-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .footer-links { display: flex; list-style: none; gap: 1.25rem; }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-title">{orgName}</a>
      <nav class="primary-nav" aria-label="Primary Navigation">
        <ul>
          <li><a href="/topics/geo-architecture/">GEO Architecture</a></li>
          <li><a href="/topics/web-performance/">Web Performance</a></li>
          <li><a href="/topics/knowledge-graphs/">Knowledge Graphs</a></li>
          <li><a href="/about/" aria-current="page">Entity Home (About)</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <span class="eyebrow">Canonical Organization Entity Home</span>
    <h1>About {orgName}</h1>
    <p>
      {orgName} is an independent research publication dedicated to empirical benchmarks, zero-JavaScript server architectures, and verifiable Schema.org knowledge graphs.
    </p>

    <div class="entity-box">
      <dl class="entity-specs">
        <dt>Canonical Entity URI</dt>
        <dd><code>{siteUrl}/#organization</code></dd>
        <dt>Primary Research Scope</dt>
        <dd>Generative Engine Optimization (GEO), Core Web Vitals, Entity SEO</dd>
        <dt>Machine Discovery</dt>
        <dd><a href="/llms.txt">/llms.txt Directory</a></dd>
      </dl>
    </div>

    <h2 id="editorial-protocol">Primary-Source Editorial Protocol</h2>
    <p>
      Every benchmark and architectural guide published on this domain is reproducible, delivered as raw server-rendered HTML, and linked to deterministic Wikidata entity nodes.
    </p>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; 2026 {orgName}. All rights reserved.</p>
      <ul class="footer-links">
        <li><a href="/about/">About / Entity Home</a></li>
        <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/llms.txt">llms.txt Directory</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>