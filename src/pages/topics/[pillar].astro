---
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob('../blog/*.md', { eager: true }));

  const pillars = [
    {
      slug: "geo-architecture",
      name: "GEO Architecture",
      fullTitle: "GEO Architecture & AI Retrieval Systems",
      eyebrow: "Pillar 01 • RAG & AI Crawlers",
      description: "Engineering server-first publishing platforms optimized for two-stage RAG retrieval, non-rendering bot access, and IndexNow push indexing.",
      summary: "Research in this pillar examines how non-rendering AI crawlers (OAI-SearchBot, PerplexityBot, ClaudeBot) ingest raw HTTP responses and how top-30% DOM summaries lift generative citation rates.",
      primaryEntityName: "Retrieval-augmented generation",
      primaryEntitySameAs: "https://www.wikidata.org/wiki/Q118976615",
      primaryEntityLabel: "Retrieval-augmented generation (Q118976615)"
    },
    {
      slug: "web-performance",
      name: "Web Performance",
      fullTitle: "Web Performance & Rendering Physics",
      eyebrow: "Pillar 02 • Core Web Vitals",
      description: "Empirical HTTP Archive evaluations comparing JavaScript hydration payloads, Islands Architecture, and mobile Interaction to Next Paint (INP).",
      summary: "Research in this pillar benchmarks server-rendered HTML architectures, zero-JS static search (Pagefind WASM), and zero-CLS responsive image pipelines.",
      primaryEntityName: "Core Web Vitals",
      primaryEntitySameAs: "https://www.wikidata.org/wiki/Q107406781",
      primaryEntityLabel: "Core Web Vitals (Q107406781)"
    },
    {
      slug: "knowledge-graphs",
      name: "Knowledge Graphs",
      fullTitle: "Entity SEO & Knowledge Graph Engineering",
      eyebrow: "Pillar 03 • Structured Data",
      description: "Disambiguating brand, author, and concept entities using deep nested JSON-LD graphs, deterministic @id URIs, and Wikidata Q-IDs.",
      summary: "Research in this pillar covers machine-readable entity disambiguation, Schema.org @graph construction, and verifiable E-E-A-T author provenance.",
      primaryEntityName: "JSON-LD",
      primaryEntitySameAs: "https://www.wikidata.org/wiki/Q6108942",
      primaryEntityLabel: "JSON-LD (Q6108942)"
    }
  ];

  return pillars.map((pillar) => {
    const filteredPosts = allPosts
      .filter((post: any) => {
        const postPillarUrl = post.frontmatter.pillarUrl || "/topics/geo-architecture/";
        return post.frontmatter.pillarName === pillar.name || postPillarUrl.includes(pillar.slug);
      })
      .sort((a: any, b: any) => new Date(b.frontmatter.datePublished).valueOf() - new Date(a.frontmatter.datePublished).valueOf());

    return { params: { pillar: pillar.slug }, props: { pillarData: pillar, posts: filteredPosts } };
  });
}

const { pillarData, posts } = Astro.props;
const siteUrl = siteConfig.url;
const orgName = siteConfig.name;
const canonicalUrl = `${siteUrl}/topics/${pillarData.slug}/`;

const hubJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${siteUrl}/#organization`, "name": orgName, "url": `${siteUrl}/` },
    { "@type": "WebSite", "@id": `${siteUrl}/#website`, "url": `${siteUrl}/`, "name": orgName, "publisher": { "@id": `${siteUrl}/#organization` }, "inLanguage": "en-US" },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": `${pillarData.fullTitle} | ${orgName}`,
      "description": pillarData.description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "breadcrumb": { "@id": `${canonicalUrl}#breadcrumb` },
      "about": [{ "@type": "Thing", "name": pillarData.primaryEntityName, "sameAs": pillarData.primaryEntitySameAs }],
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": posts.map((post: any, index: number) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": new URL(post.url, siteUrl).href,
          "name": post.frontmatter.headline
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": pillarData.name, "item": canonicalUrl }
      ]
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pillarData.fullTitle} | {orgName}</title>
  <meta name="description" content={pillarData.description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  <link rel="canonical" href={canonicalUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(hubJsonLd)} />
  <style>
    :root {
      --bg-white: #ffffff;
      --surface-subtle: #f8fafc;
      --border-light: #e2e8f0;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-primary: #1d4ed8;
      --accent-hover: #1e40af;
      --max-width-layout: 1120px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-white); color: var(--text-primary); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.65; font-size: 1.0625rem; -webkit-font-smoothing: antialiased; }
    a { color: var(--accent-primary); text-decoration: underline; text-underline-offset: 3px; }
    a:hover { color: var(--accent-hover); }
    .site-header { background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 1.25rem 1.5rem; }
    .header-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.25rem; }
    .brand-title { font-weight: 800; font-size: 1.25rem; color: var(--text-primary); text-decoration: none; letter-spacing: -0.02em; }
    .primary-nav ul { display: flex; flex-wrap: wrap; list-style: none; gap: 1.5rem; }
    .primary-nav a { text-decoration: none; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; }
    .primary-nav a:hover, .primary-nav a[aria-current="page"] { color: var(--accent-primary); font-weight: 700; }
    .breadcrumb-nav { max-width: var(--max-width-layout); margin: 1.5rem auto 0; padding: 0 1.5rem; font-size: 0.875rem; color: var(--text-muted); }
    .breadcrumb-nav ol { display: flex; flex-wrap: wrap; list-style: none; gap: 0.5rem; }
    .breadcrumb-nav li + li::before { content: "/"; margin-right: 0.5rem; color: var(--text-muted); }
    main { max-width: var(--max-width-layout); margin: 2rem auto 4rem; padding: 0 1.5rem; }
    .hero-section { padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-light); margin-bottom: 3rem; }
    .eyebrow { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.75rem; }
    h1 { font-size: clamp(2rem, 4.5vw, 2.75rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.025em; margin-bottom: 1.25rem; }
    .hero-lead { font-size: 1.15rem; color: var(--text-secondary); max-width: 820px; margin-bottom: 1.75rem; }
    .entity-summary-box { background-color: var(--surface-subtle); border: 1px solid var(--border-light); border-left: 4px solid var(--accent-primary); border-radius: 6px; padding: 1.5rem; }
    .entity-summary-title { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-primary); margin-bottom: 0.5rem; }
    h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 0.5rem; }
    .section-subtitle { color: var(--text-secondary); margin-bottom: 1.75rem; }
    section { margin-bottom: 3.5rem; }
    .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1.5rem; }
    .pillar-card { border: 1px solid var(--border-light); border-radius: 8px; padding: 1.5rem; background-color: var(--bg-white); }
    .pillar-card h3 { font-size: 1.25rem; margin-bottom: 0.65rem; }
    .pillar-card h3 a { color: var(--text-primary); text-decoration: none; }
    .pillar-card h3 a:hover { color: var(--accent-primary); text-decoration: underline; }
    .pillar-card p { color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1rem; }
    .table-wrapper { overflow-x: auto; border: 1px solid var(--border-light); border-radius: 6px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.925rem; }
    caption { font-weight: 700; padding: 0.85rem 1rem; background-color: var(--surface-subtle); border-bottom: 1px solid var(--border-light); }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border-light); vertical-align: top; }
    th { background-color: var(--surface-subtle); font-weight: 700; }
    .site-footer { border-top: 1px solid var(--border-light); padding: 2.5rem 1.5rem; font-size: 0.9rem; color: var(--text-muted); }
    .footer-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
    .footer-links { display: flex; flex-wrap: wrap; list-style: none; gap: 1.25rem; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-title">{orgName}</a>
      <nav class="primary-nav" aria-label="Primary Navigation">
        <ul>
          <li><a href="/topics/geo-architecture/" aria-current={pillarData.slug === "geo-architecture" ? "page" : undefined}>GEO Architecture</a></li>
          <li><a href="/topics/web-performance/" aria-current={pillarData.slug === "web-performance" ? "page" : undefined}>Web Performance</a></li>
          <li><a href="/topics/knowledge-graphs/" aria-current={pillarData.slug === "knowledge-graphs" ? "page" : undefined}>Knowledge Graphs</a></li>
          <li><a href="/about/">Entity Home (About)</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-current="page">{pillarData.name}</li>
    </ol>
  </nav>
  <main>
    <section class="hero-section">
      <span class="eyebrow">{pillarData.eyebrow}</span>
      <h1>{pillarData.fullTitle}</h1>
      <p class="hero-lead">{pillarData.description}</p>
      <aside class="entity-summary-box" aria-label="Pillar Entity Summary">
        <div class="entity-summary-title">Pillar Scope &amp; Primary Wikidata Entity</div>
        <p>{pillarData.summary}</p>
        <p style="margin-top: 0.75rem; font-size: 0.9rem;">
          <strong>Target Knowledge Graph Node:</strong> <a href={pillarData.primaryEntitySameAs}>{pillarData.primaryEntityLabel}</a>
        </p>
      </aside>
    </section>
    <section aria-labelledby="cluster-articles-heading">
      <h2 id="cluster-articles-heading">Published Research in {pillarData.name}</h2>
      <p class="section-subtitle">Cluster articles, empirical benchmarks, and technical blueprints assigned to this pillar hub.</p>
      {posts.length > 0 ? (
        <>
          <div class="pillar-grid" style="margin-bottom: 3rem;">
            {posts.map((post: any) => (
              <article class="pillar-card">
                <span class="eyebrow">{pillarData.name} Cluster</span>
                <h3><a href={post.url}>{post.frontmatter.headline}</a></h3>
                <p>{post.frontmatter.description}</p>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                  Published: {post.frontmatter.datePublishedDisplay || post.frontmatter.datePublished}
                </div>
              </article>
            ))}
          </div>
          <div class="table-wrapper">
            <table>
              <caption>{pillarData.name} Cluster Directory &amp; Empirical Findings</caption>
              <thead>
                <tr>
                  <th scope="col">Research Article</th>
                  <th scope="col">Primary Entity (Wikidata)</th>
                  <th scope="col">Key Empirical Finding / Metric</th>
                </tr>
              </thead>
              <tbody>
                {posts.map((post: any) => (
                  <tr>
                    <th scope="row"><a href={post.url}>{post.frontmatter.shortTitle || post.frontmatter.headline}</a></th>
                    <td>{post.frontmatter.primaryEntityLabel || pillarData.primaryEntityLabel}</td>
                    <td>{post.frontmatter.keyFinding || post.frontmatter.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : (
        <div class="pillar-card">
          <p style="margin-bottom: 0;">
            No articles are assigned to the <strong>{pillarData.name}</strong> cluster yet. Add <code>pillarName: "{pillarData.name}"</code> and <code>pillarUrl: "/topics/{pillarData.slug}/"</code> to any Markdown post in <code>src/pages/blog/</code> to populate this hub automatically.
          </p>
        </div>
      )}
    </section>
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; 2026 {orgName}. All rights reserved.</p>
      <ul class="footer-links">
        <li><a href="/about/">About / Entity Home</a></li>
        <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/llms.txt">llms.txt Directory</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>