---
import { siteConfig } from '../config/site';

const siteUrl = siteConfig.url;
const orgName = siteConfig.name;

// Dynamically load and sort all Markdown articles in src/pages/blog/
const allPosts = Object.values(import.meta.glob('./blog/*.md', { eager: true }));
const sortedPosts = allPosts.sort((a: any, b: any) =>
  new Date(b.frontmatter.datePublished).valueOf() - new Date(a.frontmatter.datePublished).valueOf()
);

// Use the newest post (or one marked featured: true) for the Flagship Featured Card
const featuredPost: any = sortedPosts.find((p: any) => p.frontmatter.featured) || sortedPosts[0];

// Deep Nested @graph JSON-LD for Homepage Entity Disambiguation
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": orgName,
      "url": `${siteUrl}/`,
      "description": siteConfig.description,
      "logo": {
        "@type": "ImageObject",
        "@id": `${siteUrl}/#logo`,
        "url": `${siteUrl}${siteConfig.logoUrl}`,
        "width": 600,
        "height": 60
      },
      "sameAs": siteConfig.author.sameAs
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": orgName,
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "en-US"
    },
    {
      "@type": "CollectionPage",
      "@id": `${siteUrl}/#webpage`,
      "url": `${siteUrl}/`,
      "name": `${orgName}: Pillar Hubs & Research Directory`,
      "description": "Structured directory of pillar guides and empirical cluster articles.",
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": sortedPosts.map((post: any, index: number) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": new URL(post.url, siteUrl).href,
          "name": post.frontmatter.headline
        }))
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary Traditional SEO Metadata -->
  <title>{orgName} | Real Estate Market Insights &amp; Strategies</title>
  <meta name="description" content={siteConfig.description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />

  <!-- Canonical Homepage URL -->
  <link rel="canonical" href={`${siteUrl}/`} />

  <!-- AI Agent & Inference-Time Discovery Protocols -->
  <link rel="alternate" type="text/markdown" href={`${siteUrl}/index.md`} title="Markdown version" />
  <link rel="describedby" href={`${siteUrl}/llms.txt`} />
  <link rel="alternate" type="application/rss+xml" title={`${orgName} RSS Feed`} href={`${siteUrl}/rss.xml`} />

  <!-- Open Graph Metadata -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${orgName} | Real Estate Market Insights`} />
  <meta property="og:description" content={siteConfig.description} />
  <meta property="og:url" content={`${siteUrl}/`} />
  <meta property="og:image" content={`${siteUrl}/images/apex-publishing-research-overview.jpg`} />

  <!-- Deep Nested @graph JSON-LD for Homepage Entity Disambiguation -->
  <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />

  <style>
    :root {
      --bg-white: #ffffff;
      --surface-subtle: #f8fafc;
      --border-light: #e2e8f0;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-primary: #1d4ed8;
      --accent-hover: #1e40af;
      --max-width-layout: 1120px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-white); color: var(--text-primary); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.65; font-size: 1.0625rem; -webkit-font-smoothing: antialiased; }
    a { color: var(--accent-primary); text-decoration: underline; text-underline-offset: 3px; }
    a:hover { color: var(--accent-hover); }

    .skip-link { position: absolute; left: -9999px; top: 0; background: var(--accent-primary); color: var(--bg-white); padding: 0.75rem 1.25rem; z-index: 100; }
    .skip-link:focus { left: 1rem; top: 1rem; }

    .site-header { background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 1.25rem 1.5rem; }
    .header-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.25rem; }
    
    .brand-title { font-weight: 800; font-size: 1.25rem; color: var(--text-primary); text-decoration: none; letter-spacing: -0.02em; }
    
    .header-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
    .primary-nav ul { display: flex; flex-wrap: wrap; list-style: none; gap: 1.5rem; }
    .primary-nav a { text-decoration: none; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; }
    .primary-nav a:hover { color: var(--accent-primary); }

    .static-search { display: flex; align-items: center; }
    .static-search input[type="search"] { padding: 0.45rem 0.75rem; border: 1px solid var(--border-light); border-radius: 4px; font-size: 0.9rem; background-color: var(--bg-white); color: var(--text-primary); }

    main { max-width: var(--max-width-layout); margin: 2.5rem auto 4rem; padding: 0 1.5rem; }

    .hero-section { padding-bottom: 2.5rem; border-bottom: 1px solid var(--border-light); margin-bottom: 3rem; }
    .eyebrow { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.75rem; }
    h1 { font-size: clamp(2rem, 4.5vw, 2.75rem); line-height: 1.15; font-weight: 800; letter-spacing: -0.025em; margin-bottom: 1.25rem; max-width: 850px; }
    .hero-lead { font-size: 1.15rem; color: var(--text-secondary); max-width: 820px; margin-bottom: 1.75rem; }

    .entity-summary-box { background-color: var(--surface-subtle); border: 1px solid var(--border-light); border-left: 4px solid var(--accent-primary); border-radius: 6px; padding: 1.5rem; }
    .entity-summary-title { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-primary); margin-bottom: 0.75rem; }
    dl.entity-qualification-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-light); font-size: 0.9rem; }
    dt { font-weight: 700; color: var(--text-primary); }
    dd { color: var(--text-secondary); }

    h2 { font-size: 1.6rem; line-height: 1.3; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .section-subtitle { color: var(--text-secondary); margin-bottom: 1.75rem; }
    section { margin-bottom: 3.5rem; }

    .featured-article { display: grid; grid-template-columns: 1fr; gap: 2rem; border: 1px solid var(--border-light); border-radius: 8px; padding: 1.75rem; background-color: var(--bg-white); }
    @media (min-width: 840px) { .featured-article { grid-template-columns: 1.2fr 1fr; align-items: center; } }
    .featured-article h3 { font-size: 1.5rem; line-height: 1.25; margin: 0.5rem 0 0.85rem; }
    .featured-article h3 a { color: var(--text-primary); text-decoration: none; }
    .featured-article h3 a:hover { color: var(--accent-primary); text-decoration: underline; }
    .article-meta { font-size: 0.875rem; color: var(--text-muted); margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 1rem; }
    .featured-figure img { width: 100%; height: auto; display: block; border-radius: 6px; border: 1px solid var(--border-light); background-color: var(--surface-subtle); }

    .pillar-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1.5rem; }
    .pillar-card { border: 1px solid var(--border-light); border-radius: 8px; padding: 1.5rem; background-color: var(--bg-white); display: flex; flex-direction: column; justify-content: space-between; }
    .pillar-card h3 { font-size: 1.25rem; margin-bottom: 0.65rem; }
    .pillar-card p { color: var(--text-secondary); font-size: 0.95rem; margin-bottom: 1.25rem; }
    .cluster-links-list { list-style: none; border-top: 1px solid var(--border-light); padding-top: 1rem; font-size: 0.925rem; }
    .cluster-links-list li { margin-bottom: 0.6rem; }

    .table-wrapper { overflow-x: auto; border: 1px solid var(--border-light); border-radius: 6px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.925rem; background-color: var(--bg-white); }
    caption { text-align: left; font-weight: 700; padding: 0.85rem 1rem; background-color: var(--surface-subtle); border-bottom: 1px solid var(--border-light); }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border-light); vertical-align: top; }
    th { background-color: var(--surface-subtle); font-weight: 700; }

    .authors-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
    .author-card { border: 1px solid var(--border-light); border-radius: 6px; padding: 1.25rem; background-color: var(--bg-white); }
    .author-card h3 { font-size: 1.1rem; margin-bottom: 0.25rem; }
    .author-role { font-size: 0.85rem; color: var(--text-muted); font-weight: 600; margin-bottom: 0.75rem; }

    .newsletter-section { padding: 2rem; border: 1px solid var(--border-light); border-radius: 8px; background-color: var(--surface-subtle); }
    .newsletter-form { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; max-width: 600px; }
    .newsletter-form input[type="email"] { flex: 1 1 260px; padding: 0.65rem 0.9rem; border: 1px solid var(--border-light); border-radius: 4px; font-size: 1rem; background-color: var(--bg-white); }
    .newsletter-form button { padding: 0.65rem 1.35rem; background-color: var(--accent-primary); color: var(--bg-white); border: none; border-radius: 4px; font-weight: 600; cursor: pointer; }

    .site-footer { border-top: 1px solid var(--border-light); padding: 2.5rem 1.5rem; background-color: var(--bg-white); font-size: 0.9rem; color: var(--text-muted); }
    .footer-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
    .footer-links { display: flex; flex-wrap: wrap; list-style: none; gap: 1.25rem; }
  </style>
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Site Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-title" aria-current="page">{orgName}</a>
      <div class="header-controls">
        <nav class="primary-nav" aria-label="Primary Navigation">
          <ul>
            <li><a href="/topics/geo-architecture/">GEO Architecture</a></li>
            <li><a href="/topics/web-performance/">Web Performance</a></li>
            <li><a href="/topics/knowledge-graphs/">Knowledge Graphs</a></li>
            <li><a href="/about/">Entity Home (About)</a></li>
          </ul>
        </nav>
        <form class="static-search" action="/search/" method="GET" role="search">
          <label for="site-search" class="skip-link">Search articles</label>
          <input type="search" id="site-search" name="q" placeholder="Search guides &amp; markets..." />
        </form>
      </div>
    </div>
  </header>

  <main id="main-content">

    <!-- Hero & Entity Summary -->
    <section class="hero-section" aria-labelledby="hero-heading">
      <span class="eyebrow">Real Estate Market Guides &amp; Insights</span>
      <h1 id="hero-heading">Empirical Research and Strategies for Las Vegas Real Estate</h1>
      <p class="hero-lead">
        {orgName} produces detailed neighborhood benchmarks, pre-foreclosure analysis, and buyer advocacy guides.
      </p>

      <aside class="entity-summary-box" aria-label="Publication Entity Summary and Qualifying Facts">
        <div class="entity-summary-title">Publication Scope &amp; Verified Baseline</div>
        <p>
          All research and guides published on this domain are driven by strict local market data, authored by verified real estate professionals, and engineered for high visibility across traditional search engines and AI generative systems.
        </p>
        <dl class="entity-qualification-grid">
          <div>
            <dt>Primary Research Pillars</dt>
            <dd>GEO Architecture, Web Performance, Knowledge Graphs</dd>
          </div>
          <div>
            <dt>Geographic Scope</dt>
            <dd>Las Vegas, Summerlin, North Las Vegas, Enterprise</dd>
          </div>
          <div>
            <dt>Target Audience Fit</dt>
            <dd>First-Time Buyers, Relocations, Property Investors</dd>
          </div>
        </dl>
      </aside>
    </section>

    <!-- Featured Pillar Research -->
    {featuredPost && (
      <section aria-labelledby="featured-research-heading">
        <h2 id="featured-research-heading">Featured Market Research</h2>
        <p class="section-subtitle">Foundational local guide with full methodology, data tables, and structured insights.</p>

        <article class="featured-article">
          <div>
            <span class="eyebrow">Flagship Guide</span>
            <h3>
              <a href={featuredPost.url}>
                {featuredPost.frontmatter.headline}
              </a>
            </h3>
            <p>
              {featuredPost.frontmatter.featuredSummary || featuredPost.frontmatter.description}
            </p>
            <p style="margin-top: 0.75rem;">
              <a href={featuredPost.url}>
                Read the full guide &rarr;
              </a>
            </p>
            <div class="article-meta">
              <span>Author: <a href={featuredPost.frontmatter.authorUrl || siteConfig.author.url}>{featuredPost.frontmatter.authorName || siteConfig.author.name}</a></span>
              <span>Updated: <time datetime={featuredPost.frontmatter.dateModified || featuredPost.frontmatter.datePublished}>{featuredPost.frontmatter.dateModifiedDisplay || featuredPost.frontmatter.datePublished}</time></span>
            </div>
          </div>
          <div class="featured-figure">
            <picture>
              <img
                src={featuredPost.frontmatter.ogImage || "https://example.com/images/geo-rag-retrieval-pipeline-architecture.jpg"}
                alt={featuredPost.frontmatter.ogImageAlt || "Architectural diagram or real estate market chart"}
                width="520"
                height="300"
              />
            </picture>
          </div>
        </article>
      </section>
    )}

    <!-- Core Topic-Cluster Pillar Hubs -->
    <section aria-labelledby="pillar-hubs-heading">
      <h2 id="pillar-hubs-heading">Topical Authority Pillar Hubs</h2>
      <p class="section-subtitle">Explore our mutually exclusive domain hubs and supporting research cluster articles.</p>

      <div class="pillar-grid">
        <!-- Pillar Hub 1 -->
        <article class="pillar-card">
          <div>
            <span class="eyebrow">Pillar 01 • RAG &amp; AI Crawlers</span>
            <h3><a href="/topics/geo-architecture/">GEO Architecture &amp; AI Retrieval</a></h3>
            <p>Engineering server-first publishing platforms optimized for two-stage RAG retrieval and IndexNow push indexing.</p>
          </div>
          <ul class="cluster-links-list">
            {sortedPosts
              .filter((p: any) => !p.frontmatter.pillarName || p.frontmatter.pillarName === "GEO Architecture")
              .map((post: any) => (
                <li><a href={post.url}>{post.frontmatter.shortTitle || post.frontmatter.headline}</a></li>
              ))}
          </ul>
        </article>

        <!-- Pillar Hub 2 -->
        <article class="pillar-card">
          <div>
            <span class="eyebrow">Pillar 02 • Core Web Vitals</span>
            <h3><a href="/topics/web-performance/">Web Performance &amp; Rendering</a></h3>
            <p>Empirical HTTP Archive evaluations comparing JavaScript hydration payloads and server-rendered architectures.</p>
          </div>
          <ul class="cluster-links-list">
            {sortedPosts
              .filter((p: any) => p.frontmatter.pillarName === "Web Performance")
              .map((post: any) => (
                <li><a href={post.url}>{post.frontmatter.shortTitle || post.frontmatter.headline}</a></li>
              ))}
          </ul>
        </article>

        <!-- Pillar Hub 3 -->
        <article class="pillar-card">
          <div>
            <span class="eyebrow">Pillar 03 • Structured Data</span>
            <h3><a href="/topics/knowledge-graphs/">Entity SEO &amp; Knowledge Graphs</a></h3>
            <p>Disambiguating brand, author, and concept entities using deep nested JSON-LD graphs and deterministic URIs.</p>
          </div>
          <ul class="cluster-links-list">
            {sortedPosts
              .filter((p: any) => p.frontmatter.pillarName === "Knowledge Graphs")
              .map((post: any) => (
                <li><a href={post.url}>{post.frontmatter.shortTitle || post.frontmatter.headline}</a></li>
              ))}
          </ul>
        </article>
      </div>
    </section>

    <!-- Structured HTML Table Directory -->
    <section aria-labelledby="directory-table-heading">
      <h2 id="directory-table-heading">Complete Research &amp; Benchmark Index</h2>
      <p class="section-subtitle">Machine-readable directory mapping recent cluster publications to their primary entities and key metrics.</p>

      <div class="table-wrapper">
        <table>
          <caption>2026 Published Articles, Target Entities, and Findings</caption>
          <thead>
            <tr>
              <th scope="col">Research Article &amp; Canonical Link</th>
              <th scope="col">Pillar Hub</th>
              <th scope="col">Primary Entity (Wikidata)</th>
              <th scope="col">Key Empirical Finding / Metric</th>
            </tr>
          </thead>
          <tbody>
            {sortedPosts.map((post: any) => (
              <tr>
                <th scope="row"><a href={post.url}>{post.frontmatter.shortTitle || post.frontmatter.headline}</a></th>
                <td><a href={post.frontmatter.pillarUrl || "/topics/geo-architecture/"}>{post.frontmatter.pillarName || "GEO Architecture"}</a></td>
                <td>{post.frontmatter.primaryEntityLabel || "Retrieval-augmented generation"}</td>
                <td>{post.frontmatter.keyFinding || post.frontmatter.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Verified Research Authors (E-E-A-T) -->
    <section aria-labelledby="authors-heading">
      <h2 id="authors-heading">Verified Authors &amp; Editorial Governance</h2>
      <p class="section-subtitle">Every publication is authored by a domain practitioner and verified against our <a href="/about/">primary-source editorial protocol</a>.</p>

      <div class="authors-grid">
        <article class="author-card">
          <h3><a href={siteConfig.author.url}>{siteConfig.author.name}</a></h3>
          <div class="author-role">{siteConfig.author.role}</div>
          <p>Lead researcher on local market trends, property acquisitions, and neighborhood benchmarks.</p>
        </article>
        <article class="author-card">
          <h3><a href="/about/">About {orgName}</a></h3>
          <div class="author-role">Organization Entity Home</div>
          <p>Review our institutional credentials, peer-review standards, compliance disclosures, and entity registry.</p>
        </article>
      </div>
    </section>

    <!-- Newsletter Form -->
    <section class="newsletter-section" aria-labelledby="newsletter-heading">
      <h2 id="newsletter-heading">Subscribe to Market Updates</h2>
      <p>Get notified when new empirical audits, market datasets, and guides are published. Zero third-party tracking scripts.</p>
      <form class="newsletter-form" action="/api/newsletter-subscribe" method="POST">
        <label for="home-subscriber-email" class="skip-link">Email Address</label>
        <input type="email" id="home-subscriber-email" name="email" placeholder="investor@company.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </section>

  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; 2026 {orgName}. All rights reserved.</p>
      <ul class="footer-links">
        <li><a href="/about/">About / Entity Home</a></li>
        <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/llms.txt">llms.txt Directory</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>