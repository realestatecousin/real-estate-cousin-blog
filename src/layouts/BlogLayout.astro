---
import { siteConfig } from '../config/site';
const { frontmatter } = Astro.props;

const siteUrl = frontmatter.siteUrl || siteConfig.url;
const orgName = frontmatter.orgName || siteConfig.name;
const orgLogo = frontmatter.orgLogo || `${siteUrl}${siteConfig.logoUrl}`;

const canonicalUrl = frontmatter.canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const pillarName = frontmatter.pillarName || "GEO Architecture";
const pillarUrl = frontmatter.pillarUrl || `${siteUrl}/topics/geo-architecture/`;
const headline = frontmatter.headline || "Untitled Research Article";
const shortTitle = frontmatter.shortTitle || headline;
const description = frontmatter.description || siteConfig.description;
const ogDescription = frontmatter.ogDescription || description;
const ogImage = frontmatter.ogImage || `${siteUrl}/images/geo-rag-retrieval-pipeline-architecture.jpg`;
const datePublished = frontmatter.datePublished || "2026-10-15T08:00:00Z";
const dateModified = frontmatter.dateModified || datePublished;
const datePublishedDisplay = frontmatter.datePublishedDisplay || datePublished;
const dateModifiedDisplay = frontmatter.dateModifiedDisplay || dateModified;
const wordCount = frontmatter.wordCount || 1150;

const authorName = frontmatter.authorName || siteConfig.author.name;
const authorRole = frontmatter.authorRole || siteConfig.author.role;
const authorUrl = frontmatter.authorUrl || siteConfig.author.url;
const authorBio = frontmatter.authorBio || `${authorName} is ${authorRole} at ${orgName}, specializing in Las Vegas real estate investment and neighborhood analysis.`;
const authorSameAs = frontmatter.authorSameAs || siteConfig.author.sameAs;

const aboutEntities = frontmatter.about || [
  {
    "@type": "Thing",
    "name": "Search engine optimization",
    "sameAs": ["https://www.wikidata.org/wiki/Q180711", "https://en.wikipedia.org/wiki/Search_engine_optimization"]
  }
];

const mentionsEntities = frontmatter.mentions || [
  {
    "@type": "Thing",
    "name": "Core Web Vitals",
    "sameAs": ["https://www.wikidata.org/wiki/Q107406781"]
  }
];

const faqs = frontmatter.faqs || [];

const allPosts = Object.values(import.meta.glob('../pages/blog/*.md', { eager: true }));
const siblingPosts = allPosts.filter((p: any) => p.url !== Astro.url.pathname).slice(0, 2);

const schemaGraph: any[] = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": orgName,
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "@id": `${siteUrl}/#logo`,
      "url": orgLogo,
      "width": 600,
      "height": 60
    },
    "sameAs": siteConfig.author.sameAs
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": orgName,
    "publisher": { "@id": `${siteUrl}/#organization` },
    "inLanguage": "en-US"
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    "url": canonicalUrl,
    "name": headline,
    "description": description,
    "isPartOf": { "@id": `${siteUrl}/#website` },
    "breadcrumb": { "@id": `${canonicalUrl}#breadcrumb` },
    "datePublished": datePublished,
    "dateModified": dateModified,
    "inLanguage": "en-US"
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
      { "@type": "ListItem", "position": 2, "name": pillarName, "item": pillarUrl },
      { "@type": "ListItem", "position": 3, "name": shortTitle, "item": canonicalUrl }
    ]
  },
  {
    "@type": "Person",
    "@id": `${authorUrl}#person`,
    "name": authorName,
    "jobTitle": authorRole,
    "url": authorUrl,
    "worksFor": { "@id": `${siteUrl}/#organization` },
    "sameAs": authorSameAs
  },
  {
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
    "headline": headline,
    "description": description,
    "image": [ogImage],
    "datePublished": datePublished,
    "dateModified": dateModified,
    "wordCount": wordCount,
    "author": { "@id": `${authorUrl}#person` },
    "publisher": { "@id": `${siteUrl}/#organization` },
    "inLanguage": "en-US",
    "about": aboutEntities,
    "mentions": mentionsEntities
  }
];

if (faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "isPartOf": { "@id": `${canonicalUrl}#webpage` },
    "mainEntity": faqs.map((faq: { question: string; answer: string }) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>{headline} | {orgName}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
  
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="text/markdown" href={`${canonicalUrl}index.md`} title="Markdown version" />
  <link rel="describedby" href={`${siteUrl}/llms.txt`} />
  <link rel="alternate" type="application/rss+xml" title={`${orgName} RSS Feed`} href={`${siteUrl}/rss.xml`} />

  <meta property="og:type" content="article" />
  <meta property="og:title" content={headline} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style is:global>
    :root {
      --bg-white: #ffffff;
      --surface-subtle: #f8fafc;
      --border-light: #e2e8f0;
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-primary: #1d4ed8;
      --accent-hover: #1e40af;
      --max-width-prose: 780px;
      --max-width-layout: 1120px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--bg-white); color: var(--text-primary); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; line-height: 1.7; font-size: 1.0625rem; -webkit-font-smoothing: antialiased; }
    a { color: var(--accent-primary); text-decoration: underline; text-underline-offset: 3px; }
    a:hover { color: var(--accent-hover); }
    .skip-link { position: absolute; left: -9999px; top: 0; background: var(--accent-primary); color: var(--bg-white); padding: 0.75rem 1.25rem; z-index: 100; }
    .skip-link:focus { left: 1rem; top: 1rem; }
    .site-header { background-color: var(--bg-white); border-bottom: 1px solid var(--border-light); padding: 1.25rem 1.5rem; }
    .header-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
    .brand-title { font-weight: 800; font-size: 1.25rem; color: var(--text-primary); text-decoration: none; letter-spacing: -0.02em; }
    .primary-nav ul { display: flex; flex-wrap: wrap; list-style: none; gap: 1.5rem; }
    .primary-nav a { text-decoration: none; color: var(--text-secondary); font-weight: 500; font-size: 0.95rem; }
    .primary-nav a:hover { color: var(--accent-primary); }
    .breadcrumb-nav { max-width: var(--max-width-prose); margin: 1.5rem auto 0; padding: 0 1.5rem; font-size: 0.875rem; color: var(--text-muted); }
    .breadcrumb-nav ol { display: flex; flex-wrap: wrap; list-style: none; gap: 0.5rem; }
    .breadcrumb-nav li + li::before { content: "/"; margin-right: 0.5rem; color: var(--text-muted); }
    main { max-width: var(--max-width-prose); margin: 2rem auto 4rem; padding: 0 1.5rem; }
    .article-header { margin-bottom: 2rem; }
    .topic-badge { display: inline-block; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); margin-bottom: 0.75rem; text-decoration: none; }
    h1 { font-size: clamp(1.85rem, 4vw, 2.5rem); line-height: 1.2; font-weight: 800; letter-spacing: -0.025em; margin-bottom: 1rem; color: var(--text-primary); }
    .eeat-meta { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; font-size: 0.9rem; color: var(--text-secondary); padding-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); }
    .executive-summary { background-color: var(--surface-subtle); border: 1px solid var(--border-light); border-left: 4px solid var(--accent-primary); border-radius: 6px; padding: 1.5rem; margin-bottom: 2.25rem; }
    .executive-summary-title { font-size: 0.95rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-primary); margin-bottom: 0.75rem; }
    .executive-summary ul { padding-left: 1.25rem; color: var(--text-primary); }
    .executive-summary li { margin-bottom: 0.5rem; }
    h2 { font-size: 1.5rem; line-height: 1.3; font-weight: 700; margin: 2.5rem 0 0.85rem; color: var(--text-primary); scroll-margin-top: 2rem; }
    h3 { font-size: 1.2rem; line-height: 1.4; font-weight: 600; margin: 1.75rem 0 0.65rem; color: var(--text-primary); }
    .anchor-link { color: var(--text-muted); text-decoration: none; font-weight: 400; margin-left: 0.35rem; font-size: 0.9em; }
    p { margin-bottom: 1.25rem; color: var(--text-secondary); }
    .direct-answer { font-weight: 500; color: var(--text-primary); }
    figure { margin: 2rem 0; border: 1px solid var(--border-light); border-radius: 6px; padding: 1rem; background-color: var(--bg-white); }
    figure img { width: 100%; height: auto; display: block; border-radius: 4px; background-color: var(--surface-subtle); }
    figcaption { font-size: 0.875rem; color: var(--text-muted); margin-top: 0.75rem; text-align: center; }
    .table-wrapper { overflow-x: auto; margin: 1.75rem 0; border: 1px solid var(--border-light); border-radius: 6px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.925rem; background-color: var(--bg-white); }
    caption { text-align: left; font-weight: 700; padding: 0.85rem 1rem; background-color: var(--surface-subtle); border-bottom: 1px solid var(--border-light); color: var(--text-primary); }
    th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border-light); vertical-align: top; }
    th { background-color: var(--surface-subtle); font-weight: 700; color: var(--text-primary); }
    dl.entity-specs { display: grid; grid-template-columns: 1fr; gap: 0.75rem; background-color: var(--surface-subtle); border: 1px solid var(--border-light); border-radius: 6px; padding: 1.25rem; margin: 1.5rem 0; }
    @media (min-width: 600px) { dl.entity-specs { grid-template-columns: 220px 1fr; } }
    dt { font-weight: 700; color: var(--text-primary); }
    dd { color: var(--text-secondary); }
    .faq-item { border-bottom: 1px solid var(--border-light); padding: 1.25rem 0; }
    .author-bio-card { margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--border-light); border-radius: 6px; background-color: var(--bg-white); }
    .author-bio-header { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.5rem; }
    .cluster-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 1rem; }
    .cluster-card { border: 1px solid var(--border-light); border-radius: 6px; padding: 1.25rem; background-color: var(--bg-white); }
    .cluster-card h3 { margin-top: 0; font-size: 1.05rem; }
    .newsletter-section { margin-top: 3rem; padding: 1.75rem; border: 1px solid var(--border-light); border-radius: 6px; background-color: var(--surface-subtle); }
    .newsletter-form { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
    .newsletter-form input[type="email"] { flex: 1 1 240px; padding: 0.65rem 0.9rem; border: 1px solid var(--border-light); border-radius: 4px; font-size: 1rem; background-color: var(--bg-white); }
    .newsletter-form button { padding: 0.65rem 1.25rem; background-color: var(--accent-primary); color: var(--bg-white); border: none; border-radius: 4px; font-weight: 600; cursor: pointer; }
    .site-footer { border-top: 1px solid var(--border-light); padding: 2.5rem 1.5rem; background-color: var(--bg-white); font-size: 0.9rem; color: var(--text-muted); }
    .footer-inner { max-width: var(--max-width-layout); margin: 0 auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem; }
    .footer-links { display: flex; flex-wrap: wrap; list-style: none; gap: 1.25rem; }
  </style>
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-title">{orgName}</a>
      <nav class="primary-nav" aria-label="Primary Navigation">
        <ul>
          <li><a href="/topics/geo-architecture/">GEO Architecture</a></li>
          <li><a href="/topics/web-performance/">Web Performance</a></li>
          <li><a href="/topics/knowledge-graphs/">Knowledge Graphs</a></li>
          <li><a href="/about/">Entity Home (About)</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href={pillarUrl}>{pillarName}</a></li>
      <li aria-current="page">{shortTitle}</li>
    </ol>
  </nav>

  <main id="main-content">
    <article>
      <header class="article-header">
        <a href={pillarUrl} class="topic-badge">Pillar Cluster: {pillarName}</a>
        <h1>{headline}</h1>
        <div class="eeat-meta">
          <span>By <a href={authorUrl} rel="author"><strong>{authorName}</strong></a>, {authorRole}</span>
          <span>Published: <time datetime={datePublished}>{datePublishedDisplay}</time></span>
          <span>Updated: <time datetime={dateModified}>{dateModifiedDisplay}</time></span>
        </div>
      </header>

      {frontmatter.summaryBullets && (
        <aside class="executive-summary" aria-label="Executive Summary">
          <div class="executive-summary-title">Executive Summary &amp; Key Findings</div>
          <ul>
            {frontmatter.summaryBullets.map((bullet: string) => (
              <li set:html={bullet} />
            ))}
          </ul>
        </aside>
      )}

      <slot />

      {faqs.length > 0 && (
        <section id="faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently Asked Questions <a href="#faq" class="anchor-link" aria-label="Permalink to FAQ section">#</a></h2>
          {faqs.map((faq: { question: string; answer: string }) => (
            <div class="faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </section>
      )}

      <section class="author-bio-card" aria-label="Author Biography">
        <div class="author-bio-header">About the Author: <a href={authorUrl}>{authorName}</a></div>
        <p>{authorBio}</p>
      </section>
    </article>

    <aside aria-label="Related Cluster Articles">
      <h2>Related Research in the {pillarName} Cluster</h2>
      <div class="cluster-grid">
        {siblingPosts.length > 0 ? (
          siblingPosts.map((post: any) => (
            <article class="cluster-card">
              <h3><a href={post.url}>{post.frontmatter.headline}</a></h3>
              <p>{post.frontmatter.description}</p>
            </article>
          ))
        ) : (
          <>
            <article class="cluster-card">
              <h3><a href="/topics/geo-architecture/wikidata-json-ld-schema-guide/">Entity-Based SEO and Nested JSON-LD</a></h3>
              <p>How to disambiguate brand and topic entities using deterministic @id nodes and Wikidata Q-IDs.</p>
            </article>
            <article class="cluster-card">
              <h3><a href="/topics/web-performance/astro-vs-nextjs-cwv-benchmark/">2026 Core Web Vitals Benchmark</a></h3>
              <p>Empirical analysis of JavaScript hydration payloads (9 KB vs. 463 KB) and mobile INP performance.</p>
            </article>
          </>
        )}
      </div>
    </aside>

    <section class="newsletter-section" aria-label="Newsletter Subscription">
      <h2>Subscribe to Market Insights &amp; Research</h2>
      <p>Receive primary-source benchmarks and data specifications directly via email.</p>
      <form class="newsletter-form" action="/api/newsletter-subscribe" method="POST">
        <label for="subscriber-email" class="skip-link">Email Address</label>
        <input type="email" id="subscriber-email" name="email" placeholder="research@company.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>&copy; 2026 {orgName}. All rights reserved.</p>
      <ul class="footer-links">
        <li><a href="/about/">About / Entity Home</a></li>
        <li><a href="/sitemap-index.xml">XML Sitemap</a></li>
        <li><a href="/rss.xml">RSS Feed</a></li>
        <li><a href="/llms.txt">llms.txt Directory</a></li>
      </ul>
    </div>
  </footer>

</body>
</html>